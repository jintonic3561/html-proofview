{
  // launch.json の preLaunchTask "npm: build" の実体。VS Code の npm スクリプト自動検出が
  // 無効でも F5 が動くように明示しておく。
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: build",
      "type": "npm",
      "script": "build",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
